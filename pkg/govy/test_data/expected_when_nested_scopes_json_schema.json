{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": {
                "strict": {
                  "const": true
                }
              },
              "required": [
                "strict"
              ]
            },
            "then": {
              "properties": {
                "child": {
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "enabled": {
                            "const": true
                          }
                        },
                        "required": [
                          "enabled"
                        ]
                      },
                      "then": {
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "const": "required"
                                }
                              },
                              "required": [
                                "kind"
                              ]
                            },
                            "then": {
                              "properties": {
                                "value": {}
                              },
                              "required": [
                                "value"
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "child": {
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
