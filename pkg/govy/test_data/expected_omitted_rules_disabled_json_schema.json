{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "anonymous": {
      "type": "string"
    },
    "itemComparison": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "type": "string"
      }
    },
    "mixed": {
      "type": "string",
      "pattern": "mapped"
    },
    "nested": {
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "timezone": {
      "type": "string"
    }
  }
}
