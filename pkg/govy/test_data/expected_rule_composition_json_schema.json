{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "allOf": [
        {
          "minimum": 5
        },
        {
          "maximum": 8
        }
      ],
      "minimum": 2,
      "maximum": 10
    },
    "optional": {
      "type": "string",
      "enum": [
        "first",
        "second"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "text": {
      "type": "string",
      "allOf": [
        {
          "pattern": "post(?![\\s\\S])"
        },
        {
          "pattern": "^[a-z]+(?![\\s\\S])"
        }
      ],
      "pattern": "^pre"
    }
  },
  "required": [
    "required"
  ]
}
