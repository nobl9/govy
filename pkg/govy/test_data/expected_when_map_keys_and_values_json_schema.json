{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "integer",
    "allOf": [
      {
        "if": {
          "exclusiveMinimum": 0
        },
        "then": {
          "minimum": 10
        }
      }
    ]
  },
  "propertyNames": {
    "type": "string",
    "allOf": [
      {
        "if": {
          "pattern": "^app/"
        },
        "then": {
          "minLength": 6
        }
      }
    ]
  }
}
