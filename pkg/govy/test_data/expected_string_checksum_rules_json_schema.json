{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StringChecksumRules",
  "type": "object",
  "properties": {
    "creditCard": {
      "type": "string",
      "pattern": "^[0-9]{13,19}(?![\\s\\S])"
    },
    "isbn": {
      "type": "string",
      "pattern": "^(?:[0-9](?:[ \\-]?[0-9]){8}[ \\-]?[0-9Xx]|9[ \\-]?7[ \\-]?[89](?:[ \\-]?[0-9]){10})(?![\\s\\S])"
    },
    "isbn13": {
      "type": "string",
      "pattern": "^9[ \\-]?7[ \\-]?[89](?:[ \\-]?[0-9]){10}(?![\\s\\S])"
    },
    "issn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{3}[0-9Xx](?![\\s\\S])"
    },
    "luhnChecksum": {
      "type": "string",
      "pattern": "^[0-9]+(?![\\s\\S])"
    }
  }
}
