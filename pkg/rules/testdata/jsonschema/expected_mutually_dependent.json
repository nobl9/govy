    {
      "required": [
        "Card",
        "Cash",
        "Transfer"
      ]
    },
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "Card"
            ]
          },
          {
            "required": [
              "Cash"
            ]
          },
          {
            "required": [
              "Transfer"
            ]
          }
        ]
      }
    }
  ]
}
