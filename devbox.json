{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/refs/heads/main/.schema/devbox.schema.json",
  "packages": [
    "govulncheck@1.6.0",
    "gotools@0.44.0",
    "markdownlint-cli@0.49.1",
    "cspell@9.7.0",
    "golangci-lint@2.12.2",
    "go@1.26.5",
    "nodejs@22.23.2"
  ],
  "shell": {
    "init_hook": [
      "export GOROOT=$(go env GOROOT)",
      "npm ci --prefix \"$DEVBOX_PROJECT_ROOT/internal/jsonschematest/testdata\" --ignore-scripts --no-audit --no-fund"
    ]
  }
}
